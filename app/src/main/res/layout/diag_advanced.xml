<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp"
        android:text="@string/advanced_title"
        android:textColor="@color/text_main"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/row_chunk"
        style="@style/SettingRow">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/advanced_chunk"
            android:textColor="@color/text_main"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_chunk_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_slack"
        style="@style/SettingRow">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/advanced_slack"
            android:textColor="@color/text_main"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_slack_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_attempts"
        style="@style/SettingRow">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/advanced_attempts"
            android:textColor="@color/text_main"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_attempts_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_verbose"
        style="@style/SettingRow">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/advanced_verbose"
            android:textColor="@color/text_main"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_verbose_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_loglevel"
        style="@style/SettingRow">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/advanced_loglevel"
            android:textColor="@color/text_main"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_loglevel_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
