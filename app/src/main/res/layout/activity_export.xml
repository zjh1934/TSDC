<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.3 分层布局。上一版 838 行 / 74 个元素全堆在一个纵向栈里同屏竞争，
  这版按「什么时候才需要」拆成四层：

    L1 顶栏（固定）    书名压成单行 + ⋮ 收纳所有低频入口
    L1.5 状态条（固定） 一行摘要 + 2dp 细进度线，滚到列表底部也看得见
    L2 内容区（滚动）    标签 + 筛选 + 列表，把正文全宽还给内容
    L3 底部（固定）    播放条（可收起）+ 动作条

  设置（21 个元素）和队列管理（5 个）整体搬进 ⋮ 弹层，正文不再为低频参数留位置。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingTop="6dp"
        android:paddingRight="4dp"
        android:paddingBottom="6dp">


        <TextView
        android:id="@+id/btn_back"
        style="@style/IconBtn"
        android:text="‹" />

        <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
        android:id="@+id/tv_book"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_main"
        android:textSize="16sp"
        android:textStyle="bold" />


        <TextView
        android:id="@+id/tv_book_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_sub"
        android:textSize="11sp" />
        </LinearLayout>


        <TextView
        android:id="@+id/dot_queue"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginRight="8dp"
        android:background="@drawable/bg_dot_alert"
        android:visibility="gone" />

        <TextView
        android:id="@+id/btn_more"
        style="@style/IconBtn"
        android:text="⋮" />
    </LinearLayout>

    <!-- ================= 有书时的导出页 ================= -->
    <FrameLayout
        android:id="@+id/panel_book"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <LinearLayout
                android:id="@+id/status_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingTop="8dp"
                android:paddingRight="8dp"
                android:paddingBottom="8dp">


                <TextView
                android:id="@+id/badge_status"
                style="@style/StatusBadge"
                android:text="○" />


                <TextView
                android:id="@+id/tv_status_line"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_main"
                android:textSize="13sp" />

                <TextView
                android:id="@+id/tv_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />


                <TextView
                android:id="@+id/btn_fail_badge"
                style="@style/IconBtn"
                android:layout_marginLeft="4dp"
                android:text="!"
                android:visibility="gone" />

                <TextView
                android:id="@+id/btn_status_expand"
                style="@style/IconBtn"
                android:layout_marginLeft="2dp"
                android:text="⌄" />
            </LinearLayout>
            <!-- 2dp 细线：滚到列表底部也始终知道总进度，不靠那张大卡 -->
            <ProgressBar
                android:id="@+id/progress_line"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progressDrawable="@drawable/progress_track" />

            <!-- ── 标签 + 筛选 合并成一行工具条，再省一行高度 ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tab_chapters"
                    style="@style/TabChip"
                    android:layout_marginRight="5dp" />

                <TextView
                    android:id="@+id/tab_outputs"
                    style="@style/TabChip" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- 章节页筛选 -->
                <LinearLayout
                    android:id="@+id/filter_chapter_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/filter_ch_pending"
                        style="@style/FilterChip"
                        android:text="@string/filter_pending" />

                    <TextView
                        android:id="@+id/filter_ch_done"
                        style="@style/FilterChip"
                        android:layout_marginLeft="5dp"
                        android:text="@string/filter_done" />

                    <!-- 「全部」和四个勾选动作收进这个按钮 -->
                    <TextView
                        android:id="@+id/btn_select_menu"
                        style="@style/FilterChip"
                        android:layout_marginLeft="5dp"
                        android:text="@string/filter_chapter" />
                </LinearLayout>

                <!-- 成品页筛选 -->
                <LinearLayout
                    android:id="@+id/filter_output_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/btn_output_info"
                        style="@style/FilterChip"
                        android:text="@string/where_title" />

                    <TextView
                        android:id="@+id/btn_output_clean"
                        style="@style/FilterChip"
                        android:layout_marginLeft="5dp"
                        android:text="@string/output_clean_all" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── 章节列表 ── -->
            <ListView
                android:id="@+id/list_chapters"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="7dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:divider="@null"
                android:dividerHeight="6dp"
                android:listSelector="#00000000"
                android:paddingBottom="6dp"
                android:scrollbars="none" />

            <!-- ── 成品列表 ── -->
            <ListView
                android:id="@+id/list_outputs"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="7dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:divider="@null"
                android:dividerHeight="6dp"
                android:listSelector="#00000000"
                android:paddingBottom="6dp"
                android:scrollbars="none"
                android:visibility="gone" />

            <!-- ── 空态（成品页无内容时） ── -->
            <LinearLayout
                android:id="@+id/output_empty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_output_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/output_empty_title"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_output_empty_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/output_empty_sub"
                    android:textColor="@color/text_sub"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- ── 停止后的续传提示，一行说明，不占固定高度 ── -->
            <TextView
                android:id="@+id/tv_resume_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_hint_box"
                android:lineSpacingExtra="2dp"
                android:paddingLeft="10dp"
                android:paddingTop="7dp"
                android:paddingRight="10dp"
                android:paddingBottom="7dp"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/playback_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_playbar"
                android:orientation="vertical"
                android:visibility="gone">


                <LinearLayout
                android:id="@+id/play_bar_collapsed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingTop="5dp"
                android:paddingRight="8dp"
                android:paddingBottom="5dp"
                android:visibility="gone">

                <TextView
                android:id="@+id/btn_play_toggle_mini"
                style="@style/PlayBtn"
                android:text="▶" />

                <TextView
                android:id="@+id/tv_play_title_mini"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/playbar_fg"
                android:textSize="12sp" />

                <TextView
                android:id="@+id/btn_play_expand"
                style="@style/PlayBtn"
                android:layout_marginLeft="6dp"
                android:text="⌃" />
                </LinearLayout>

                <LinearLayout
                android:id="@+id/play_bar_expanded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="10dp"
                android:paddingTop="6dp"
                android:paddingRight="6dp"
                android:paddingBottom="6dp">

                <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                android:id="@+id/btn_play_toggle"
                style="@style/PlayBtn"
                android:text="▶" />

                <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                android:id="@+id/tv_play_title"
                style="@style/PlayTitle" />

                <TextView
                android:id="@+id/tv_play_sub"
                style="@style/PlaySub" />
                </LinearLayout>

                <TextView
                android:id="@+id/btn_play_fold"
                style="@style/PlayBtn"
                android:layout_marginLeft="6dp"
                android:text="⌄" />

                <TextView
                android:id="@+id/btn_play_close"
                style="@style/PlayBtn"
                android:layout_marginLeft="2dp"
                android:text="✕" />
                </LinearLayout>

                <SeekBar
                android:id="@+id/play_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:max="1000"
                android:progressDrawable="@drawable/progress_play" />
                </LinearLayout>
            </LinearLayout>
            <!-- ── L3 动作条：主 CTA，唯一常驻不可藏的东西 ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="9dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_start"
                    style="@style/BtnPrimary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="@string/start_export" />

                <TextView
                    android:id="@+id/btn_stop"
                    style="@style/BtnGhost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="7dp"
                    android:layout_weight="1"
                    android:text="@string/stop_export" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ================= 无书时的合成队列页 ================= -->
    <LinearLayout
        android:id="@+id/panel_center"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/queue_title"
                android:textColor="@color/text_main"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_center_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/center_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressDrawable="@drawable/progress_track" />

            <TextView
                android:id="@+id/tv_center_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_sub"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_center_stop"
                style="@style/BtnGhost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stop_current" />

            <TextView
                android:id="@+id/btn_center_clear"
                style="@style/BtnGhost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7dp"
                android:layout_weight="1"
                android:text="@string/clear_queue" />
        </LinearLayout>

        <!-- 队列页也提供一个返回，去掉原先「只能去书架」的死路 -->
        <TextView
            android:id="@+id/btn_center_back"
            style="@style/BtnGhost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/back_library" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/queue_list_title"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <ListView
            android:id="@+id/list_queue"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="6dp"
            android:listSelector="#00000000"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/btn_center_empty"
            style="@style/BtnGhost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="9dp"
            android:text="@string/go_library" />
    </LinearLayout>
</LinearLayout>