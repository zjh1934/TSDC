    <!-- ===== 后台运行设置（防杀后台引导） ===== -->
    <string name="menu_keepalive">后台运行设置</string>
    <string name="title_keepalive">后台运行设置</string>
    <string name="keepalive_title">后台运行设置</string>
    <!-- 顶部解释：讲清「为什么」，而不是让用户照抄系统文案 -->
    <string name="keepalive_intro">合成一本长书要好几个小时，这期间你会息屏、切走去干别的。手机系统都把App 当成「没用」的东西，会在后台偷偷掐掉它——被掐一次，这本书就得从头再来。\n下面这几项逐个放开，系统就基本不会来打断合成了。每项右边都有按钮，直接跳到对应的系统设置。改完回到这个页面，状态会自动重新判定。</string>
    <string name="ka_item_battery">电池优化白名单</string>
    <string name="ka_item_battery_desc">不加白名单时，息屏一会儿系统就会把合成限速甚至暂停，长书基本跑不完</string>
    <string name="ka_item_autorun">自启动 / 后台管理</string>
    <string name="ka_item_autorun_desc">各家系统的名字不一样（小米：省电策略→自启动+后台弹窗；华为/ OPPO / vivo：应用启动管理）。系统没开放接口，只能你自己进去看</string>
    <string name="ka_item_overlay">悬浮窗 / 允许后台弹出界面</string>
    <string name="ka_item_overlay_desc">放开后合成时能显示悬浮控制条；不给也不影响合成，只是看不到这个开关</string>
    <string name="ka_item_notify">通知权限</string>
    <string name="ka_item_notify_desc">通知被关掉的话，合成跑起来你什么提示都收不到，只能反复回来看</string>
    <string name="ka_state_on">✓ 已开启</string>
    <string name="ka_state_off">! 未开启</string>
    <!-- 注意：不能以 ? 开头，aapt2 会把它当成资源引用（"resource attr/? not found"） -->
    <string name="ka_state_manual">需手动确认</string>
    <string name="ka_state_na">本机系统无需设置</string>
    <string name="ka_go">去设置</string>
    <string name="ka_summary_fmt">%1$d 项已就绪 · %2$d 项待确认</string>
    <string name="ka_summary_all_ok">全部就绪，合成不会再被系统打断了</string>
    <!-- 所有跳转都失败时的手写兜底：国产 ROM 砍设置页是必然会遇到的 -->
    <string name="ka_manual_hint">点「去设置」没反应的话，说明这个系统把那个入口藏起来或改路径了。请手动到「设置 → 应用设置 → 应用管理 → 听书导出」里，把省电策略、无限制自启动、后台运行、通知和悬浮窗都打开。</string>
    <string name="ka_jump_failed">这台手机没有这个系统设置页，已记入日志。\n请手动到「设置 → 应用管理 → 听书导出」里打开对应开关。</string>
